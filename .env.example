# ============================================
#       🩸 NEZUKO — Configuration
# ============================================
# Copiez ce fichier en .env et remplissez vos infos
# cp .env.example .env

# 📞 Numéro du PROPRIÉTAIRE du bot (sans + et sans espace)
OWNER_NUMBER=224664014102
OWNER_NAME=HABY HINATA

# 🛠️ Numéros des CRÉATEURS / développeurs (séparés par une virgule, accès total)
CREATOR_NUMBERS=224621963059,224662675862
CREATOR_NAMES=IB-SACKO,SALGA

# 🏷️ Nom du système / communauté
SYSTEM_NAME=CENTRAL-HEX

# 🤖 Nom du bot
BOT_NAME=NEZUKO

# 🌍 Mode du bot: public ou private
COMMAND_MODE=public

# 🎨 Nom / auteur du pack de stickers
PACK_NAME=NEZUKO
PACK_AUTHOR=IB-SACKO & SALGA

# 📌 Version du bot
BOT_VERSION=1.0.0

# 🛡️ Mot de passe du dashboard admin (/admin) — OBLIGATOIRE pour y accéder
ADMIN_PASSWORD=

# 🌐 URL publique de ton bot (optionnel, pour l'auto-ping anti-veille)
APP_URL=

# 🧠 Nombre maximum de sessions WhatsApp connectées en même temps.
# Laisse à 1 sur un hébergeur gratuit (512 Mo de RAM) pour éviter les crashs.
MAX_SESSIONS=1

